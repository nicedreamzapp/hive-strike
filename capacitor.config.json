{
  "appId": "com.nicedreamz.hivestrike",
  "appName": "Hive Strike",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b1a0c"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b1a0c",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0b1a0cff",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#0b1a0c"
    }
  }
}
