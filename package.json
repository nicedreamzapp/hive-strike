{
  "name": "hive-strike",
  "version": "1.3.0",
  "private": true,
  "description": "Vertical bug shooter. Every asset generated locally on one Mac.",
  "scripts": {
    "build": "python3 tools/assemble.py && python3 tools/build_mobile.py",
    "build:fast": "python3 tools/assemble.py && python3 tools/build_mobile.py --fast",
    "test": "node tools/test_walkthrough.mjs",
    "serve": "python3 -m http.server 8919 --bind 127.0.0.1",
    "sync": "npm run build && npx cap sync",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "assemble": "python3 tools/assemble.py"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "cordova-plugin-purchase": "^13.18.0"
  }
}